{
  "name": "fireplayer-cross-platform",
  "version": "1.8.1",
  "description": "FirePlayer cross-platform desktop app for Windows, Ubuntu, and macOS.",
  "homepage": "https://github.com/randomwalk0101/FirePlayer",
  "author": {
    "name": "randomwalk0101",
    "email": "randomwalk0101@users.noreply.github.com"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "build:win": "electron-builder --win nsis portable --x64",
    "build:linux": "electron-builder --linux AppImage deb --x64",
    "build:mac": "electron-builder --mac dmg zip"
  },
  "build": {
    "appId": "com.fireplace.fireplayer",
    "productName": "FirePlayer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "assets/AppIcon.png"
    },
    "win": {
      "icon": "assets/AppIcon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "assets/AppIcon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "maintainer": "randomwalk0101 <randomwalk0101@users.noreply.github.com>"
    }
  },
  "devDependencies": {
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8"
  }
}
